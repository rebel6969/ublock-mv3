Windows Registry Editor Version 5.00

; uBlock MV3 - FORCE install policy for Google Chrome
;
; Use this only if chrome-policy.reg leaves the extension disabled.
;
; "force_installed" means the browser is not permitted to disable or remove the
; extension, which overrides the greylist disabling that blocks off-store
; extensions. It is the strongest option and the one that always works.
;
; THE TRADE-OFF
; You cannot disable or remove it from chrome://extensions while this policy is
; in place -- the toggle and Remove button are gone. To get rid of it you must
; merge install/uninstall-policy.reg and restart. Know that before applying it.
;
; DO NOT ALSO ADD THE CRX BY HAND
; This is the step that catches people out. A manually dropped CRX installs as
; location INTERNAL, and policy rules only govern POLICY-installed extensions
; (location EXTERNAL_POLICY_DOWNLOAD). The browser therefore keeps greylisting
; the manual copy and ignores the policy completely. Let the browser fetch it.
;
; HOW TO USE
;   1. chrome://extensions -> Remove any existing copy of uBlock MV3
;   2. Right-click this file -> Merge (accept the admin prompt)
;   3. Quit Chrome completely (check the system tray), then reopen it
;   4. Wait ~30 seconds; the extension installs itself and is enabled
;
; To confirm the policy is being read: chrome://policy should list
; ExtensionInstallForcelist and ExtensionSettings. "Reload policies" there
; forces a re-check without restarting.
;
; TO UNDO
;   Merge install/uninstall-policy.reg, then restart Chrome.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionSettings\lhenbhhllfnidhehplimafdahmiihlbc]
"installation_mode"="force_installed"
"update_url"="https://github.com/rebel6969/ublock-mv3/releases/latest/download/updates.xml"
"toolbar_pin"="force_pinned"

; ExtensionInstallForcelist is the older, more widely implemented force-install
; mechanism. Setting both is deliberate: some builds honour one and not the
; other, and they do not conflict.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallForcelist]
"9000"="lhenbhhllfnidhehplimafdahmiihlbc;https://github.com/rebel6969/ublock-mv3/releases/latest/download/updates.xml"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallAllowlist]
"9000"="lhenbhhllfnidhehplimafdahmiihlbc"
